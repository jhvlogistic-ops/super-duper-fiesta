# Configura al menos UNA de estas tres claves. El cliente probara los
# proveedores en este orden hasta que uno responda con exito.

# 1) Claude Sonnet 4.5 via GitHub Models (gratis con rate limits diarios)
#    Crea un PAT con scope "models:read" en:
#    https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=

# 2) Gemini 2.5 Pro via Google AI Studio (1M de contexto, tier gratuito generoso)
#    Obten tu clave en:
#    https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# 3) DeepSeek V3.1 (no es gratis pero cuesta centimos por millon de tokens)
#    Obten tu clave en:
#    https://platform.deepseek.com
DEEPSEEK_API_KEY=
